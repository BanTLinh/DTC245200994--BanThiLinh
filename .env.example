# Cấu hình môi trường mẫu cho Đề 34: Hệ thống Quản lý Hợp đồng
# Lưu ý: Không điền thông tin thật vào file này khi đẩy lên GitHub!
# Tạo bản sao .env từ file này và điền thông tin bí mật tại môi trường local.
# ==========================================

# Django Configuration
DJANGO_SECRET_KEY=insecure-template-secret-key-replace-in-env-file
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL Configuration
POSTGRES_DB=contract_db
POSTGRES_USER=contract_user
POSTGRES_PASSWORD=contract_secure_password_example
POSTGRES_HOST=db
POSTGRES_PORT=5432
